# Konfiguracja środowiska DYSKURS
PROJECT_NAME=DYSKURS
ENV=development

# Baza danych (PostgreSQL)
# W kontenerze Docker: postgresql+asyncpg://dyskurs:dyskurs_secret@postgres:5432/dyskurs_db
# Lokalnie bez Dockera domyślnie używany jest SQLite async: sqlite+aiosqlite:///./dyskurs.db
DATABASE_URL=sqlite+aiosqlite:///./dyskurs.db

# Kolejka Redis
# W kontenerze Docker: redis://redis:6379/0
# Lokalnie: redis://localhost:6379/0 lub wbudowany fallback in-process
REDIS_URL=redis://localhost:6379/0

# Magazyn plików
STORAGE_DIR=./storage/media

# Klucze API (do kolejnych faz)
GEMINI_API_KEY=
HF_TOKEN=

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
