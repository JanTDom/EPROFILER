# Konfiguracja środowiska PROFILER
PROJECT_NAME=PROFILER
ENV=development

# Baza danych (PostgreSQL / SQLite)
DATABASE_URL=sqlite+aiosqlite:///./profiler.db

# Kolejka Redis
REDIS_URL=redis://localhost:6379/0

# Magazyn plików
STORAGE_DIR=./storage/media

# Klucze API
GEMINI_API_KEY=
HF_TOKEN=

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
